### Simulate a delivery.created webhook (local testing)
POST http://localhost:8080/webhooks/uber
Content-Type: application/json
X-Postmates-Signature: test-bypass

{
  "event_type": "delivery.created",
  "event_id": "evt_001",
  "created": 1234567890,
  "meta": {
    "resource_id": "del_sj2VMgUFSY6ivDjzZepFVQ",
    "status": "created"
  }
}

